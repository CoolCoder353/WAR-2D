/* WAR-2D theme. Generated from the approved v0.6 Figma variables (docs/ux/v0.6-figma.md), reskinned by the
   approved v0.8 pass (docs/ux/v0.8-figma.md): square corners, a 2 px pixel bevel, sizes +2 px for the pixel font.
   Variable color/surface/panel is --color-surface-panel. Change values in Figma first. */

:root {
    --color-surface-base: #26303A;
    --color-surface-panel: #34404C;
    --color-surface-raised: #40505F;
    --color-border: #52627A;
    --color-text-primary: #F0F4F8;
    --color-text-secondary: #AEBBCB;
    --color-text-disabled: #6B7A8C;
    --color-accent: #3FD0FF;
    --color-on-accent: #062633;
    --color-readout: #FFC857;
    --color-success: #5BE37D;
    --color-warning: #FF9A3D;
    --color-danger: #FF5263;
    --color-player-1: #4DA3FF;
    --color-player-2: #E5484D;
    --color-player-3: #46C46B;
    --color-player-4: #F2C230;
    --color-player-5: #A970FF;
    --color-player-6: #F07F2E;
    --color-player-7: #2FC4C4;
    --color-player-8: #E85FB5;
    --space-1: 4px;
    --space-2: 8px;
    --space-3: 12px;
    --space-4: 16px;
    --space-6: 24px;
    --space-8: 32px;
    --space-12: 48px;
    --font-size-12: 14px;
    --font-size-14: 16px;
    --font-size-16: 18px;
    --font-size-20: 22px;
    --font-size-28: 32px;
    --radius-sm: 0px;
    --radius-md: 0px;
    --radius-lg: 0px;
    /* v0.8 pixel bevel: lit top-left, shaded bottom-right edges on panels and buttons. */
    --color-bevel-light: rgba(255, 255, 255, 0.22);
    --color-bevel-dark: rgba(0, 0, 0, 0.45);
}

/* v0.8: the pixel font (Jersey 10, SIL OFL, Assets/UI/Fonts/OFL.txt). It has no bold, so weight comes from size and colour. */
:root { -unity-font-definition: url("Fonts/Jersey10-Regular.ttf"); }

.palette-colourblind {
    --color-surface-base: #26303A;
    --color-surface-panel: #34404C;
    --color-surface-raised: #40505F;
    --color-border: #52627A;
    --color-text-primary: #F0F4F8;
    --color-text-secondary: #AEBBCB;
    --color-text-disabled: #6B7A8C;
    --color-accent: #3FD0FF;
    --color-on-accent: #062633;
    --color-readout: #F0E442;
    --color-success: #56B4E9;
    --color-warning: #E69F00;
    --color-danger: #F06BB8;
    --color-player-1: #E69F00;
    --color-player-2: #56B4E9;
    --color-player-3: #009E73;
    --color-player-4: #F0E442;
    --color-player-5: #0072B2;
    --color-player-6: #D55E00;
    --color-player-7: #CC79A7;
    --color-player-8: #BBBBBB;
}

.palette-high-contrast {
    --color-surface-base: #000000;
    --color-surface-panel: #0B0F14;
    --color-surface-raised: #1A1F26;
    --color-border: #FFFFFF;
    --color-text-primary: #FFFFFF;
    --color-text-secondary: #D9E2EC;
    --color-text-disabled: #8A96A3;
    --color-accent: #00E5FF;
    --color-on-accent: #001A20;
    --color-readout: #FFE14D;
    --color-success: #3DFF7A;
    --color-warning: #FFB000;
    --color-danger: #FF4D4D;
    --color-player-1: #3DA5FF;
    --color-player-2: #FF5A5A;
    --color-player-3: #3DFF7A;
    --color-player-4: #FFE14D;
    --color-player-5: #C38BFF;
    --color-player-6: #FF9F3D;
    --color-player-7: #3DFFF0;
    --color-player-8: #FF7AD9;
}

.player-1 { background-color: var(--color-player-1); }
.player-2 { background-color: var(--color-player-2); }
.player-3 { background-color: var(--color-player-3); }
.player-4 { background-color: var(--color-player-4); }
.player-5 { background-color: var(--color-player-5); }
.player-6 { background-color: var(--color-player-6); }
.player-7 { background-color: var(--color-player-7); }
.player-8 { background-color: var(--color-player-8); }

.hud-root { flex-grow: 1; }
.panel { background-color: var(--color-surface-panel); border-width: 2px; border-color: var(--color-border); border-top-color: var(--color-bevel-light); border-left-color: var(--color-bevel-light); border-bottom-color: var(--color-bevel-dark); border-right-color: var(--color-bevel-dark); border-radius: var(--radius-lg); overflow: hidden; }
.panel__title { background-color: var(--color-surface-raised); color: var(--color-text-primary); font-size: var(--font-size-14); -unity-font-style: normal; padding: var(--space-2) var(--space-3); }
.text { color: var(--color-text-primary); font-size: var(--font-size-14); }
.text--secondary { color: var(--color-text-secondary); font-size: var(--font-size-12); }
.text--readout { color: var(--color-readout); -unity-font-style: normal; }
.text--success { color: var(--color-success); font-size: var(--font-size-12); }
.text--disabled { color: var(--color-text-disabled); }
.button { background-color: var(--color-surface-panel); border-width: 2px; border-color: var(--color-border); border-top-color: var(--color-bevel-light); border-left-color: var(--color-bevel-light); border-bottom-color: var(--color-bevel-dark); border-right-color: var(--color-bevel-dark); border-radius: var(--radius-sm); color: var(--color-text-primary); font-size: var(--font-size-14); padding: var(--space-2) var(--space-3); margin: 0; }
.button:hover { background-color: var(--color-surface-raised); border-color: var(--color-text-primary); }
.button--primary { background-color: var(--color-accent); color: var(--color-on-accent); border-width: 0; }
.button:disabled { background-color: var(--color-surface-panel); color: var(--color-text-disabled); border-color: var(--color-border); }
.swatch { width: 10px; height: 10px; border-radius: 0; }
.swatch--eliminated { background-color: var(--color-text-disabled); }

/* Top bar (Figma: HUD / Default, Top bar) */
.top-bar { position: absolute; left: 0; top: 0; right: 0; height: 44px; flex-direction: row; align-items: center; padding-left: var(--space-4); padding-right: var(--space-4); background-color: var(--color-surface-panel); border-bottom-width: 1px; border-color: var(--color-border); }
.top-bar__players { flex-grow: 1; flex-basis: 0; flex-direction: row; align-items: center; overflow: hidden; min-width: 0; }
.top-bar__player { flex-direction: row; align-items: center; margin-right: var(--space-4); flex-shrink: 1; min-width: 24px; overflow: hidden; }
.top-bar__player .player-name { flex-shrink: 1; min-width: 0; overflow: hidden; }
.top-bar__player .player-name__text { flex-shrink: 1; min-width: 0; overflow: hidden; white-space: nowrap; text-overflow: ellipsis; }
.top-bar__player .ai-tag__label { display: none; }
.top-bar__player .swatch { margin-right: 6px; }
.top-bar__name { color: var(--color-text-primary); font-size: var(--font-size-12); }
.top-bar__name--eliminated { color: var(--color-text-disabled); }
.top-bar__resources { flex-direction: row; align-items: center; }
.top-bar__resources > Label { margin-right: var(--space-2); }
.top-bar__resources-value { font-size: var(--font-size-20); }
.top-bar__actions { flex-grow: 1; flex-basis: 0; flex-direction: row; justify-content: flex-end; }
.top-bar__actions > Button { margin-left: var(--space-2); }

/* HUD layers: each section's template fills the screen and ignores the pointer; only its panels pick. */
.hud-layer { position: absolute; left: 0; top: 0; right: 0; bottom: 0; }
.text--muted { color: var(--color-text-secondary); }
.icon-slot { width: 24px; height: 24px; border-width: 1px; border-color: var(--color-text-secondary); border-radius: 0; }

/* Command card (Figma: HUD / Default, Panel / Commands; HUD states, Spawner selected) */
.command-card { position: absolute; right: var(--space-4); bottom: var(--space-4); }
.command-card__content { padding: var(--space-3); }
.command-card__row { flex-direction: row; }
.command-card__divider { height: 1px; background-color: var(--color-border); margin-top: var(--space-2); margin-bottom: var(--space-2); }
.command-button { width: 56px; height: 56px; margin: 0 6px 0 0; padding: 4px 0 0 0; align-items: center; justify-content: space-between; background-color: var(--color-surface-panel); border-width: 2px; border-color: var(--color-border); border-top-color: var(--color-bevel-light); border-left-color: var(--color-bevel-light); border-bottom-color: var(--color-bevel-dark); border-right-color: var(--color-bevel-dark); border-radius: var(--radius-sm); color: var(--color-text-primary); }
.command-button:hover { background-color: var(--color-surface-raised); }
.command-button:disabled { color: var(--color-text-disabled); background-color: var(--color-surface-panel); }
.command-button--active { background-color: var(--color-accent); border-color: var(--color-text-primary); color: var(--color-on-accent); }
.command-button--active:hover { background-color: var(--color-accent); }
.command-icon { width: 32px; height: 32px; -unity-background-scale-mode: scale-to-fit; }
.command-button__key { font-size: var(--font-size-12); -unity-font-style: normal; color: var(--color-text-secondary); height: 15px; margin-bottom: 4px; padding: 0; -unity-text-align: middle-center; }
.command-button:disabled .command-button__key { color: var(--color-text-disabled); }
.command-button--active .command-button__key { color: var(--color-on-accent); }
/* The pixel icons are white bitmaps; each button state tints them like its text. */
.command-icon { -unity-background-image-tint-color: var(--color-text-primary); }
.command-button:disabled .command-icon { -unity-background-image-tint-color: var(--color-text-disabled); }
.command-button--active .command-icon { -unity-background-image-tint-color: var(--color-on-accent); }
.production { display: none; }
.command-card--building .production { display: flex; }
.command-card--building #orders, .command-card--building #divider, .command-card--building #builds { display: none; }
.production__row { flex-direction: row; align-items: center; margin-top: var(--space-2); margin-bottom: var(--space-2); }
.production__row > * { margin-right: var(--space-2); }
.production__button { width: 36px; height: 35px; padding: 0; -unity-text-align: middle-center; }
.production__count { font-size: var(--font-size-20); min-width: 22px; -unity-text-align: middle-center; }
.production__button--wide { width: 48px; }
.spectating { position: absolute; top: 56px; left: 50%; width: 560px; margin-left: -280px; }
.spectating__body { padding: var(--space-3); }
.spectating__leave { width: 150px; margin-top: var(--space-2); }
.production__rally { flex-direction: row; align-items: center; margin-top: var(--space-2); }
/* v0.7 command card (Figma: Command card – v0.7) */
.command-button__cost { color: var(--color-readout); }
.command-button:disabled .command-button__cost { color: var(--color-text-disabled); }
/* v0.15.1 card-slot key, top-left of build and production buttons (Figma v0.15.1 Hotkeys and polish, H1) */
.command-button__hotkey { position: absolute; left: 3px; top: 0; font-size: var(--font-size-12); -unity-font-style: normal; color: var(--color-text-secondary); padding: 0; margin: 0; }
.command-button:hover .command-button__hotkey { color: var(--color-text-primary); }
.command-button:disabled .command-button__hotkey { color: var(--color-text-disabled); }
.command-button--active .command-button__hotkey { color: var(--color-on-accent); }
.command-card__hint { margin-top: var(--space-2); white-space: normal; max-width: 356px; }
.command-card--builders { width: 452px; } /* v0.12: seven build buttons (Figma Command card – v0.12) */
.production__unit { width: 56px; }
.production__cost { width: 32px; color: var(--color-readout); font-size: var(--font-size-12); }
.removal { display: none; }
.command-card--building .removal { display: flex; }
.removal > * { margin-bottom: var(--space-2); }
.removal__confirm { display: none; padding: var(--space-3); background-color: var(--color-surface-raised); border-width: 1px; border-color: var(--color-danger); }
.removal__confirm--open { display: flex; }
.removal__confirm > * { margin-bottom: var(--space-2); }
.removal__buttons { flex-direction: row; }
.removal__buttons > * { margin-right: var(--space-2); }
.wall-readout { position: absolute; padding: 2px var(--space-2); background-color: rgba(0, 0, 0, 0.55); }
.wall-readout > Label { padding: 0; margin: 0; font-size: var(--font-size-16); }
.production__rally-icon { width: 16px; height: 16px; margin-right: var(--space-2); flex-shrink: 0; }
.production__rally > Label { white-space: normal; flex-shrink: 1; }

/* Selection panel (Figma: Panel / Selection) */
.selection-panel { position: absolute; left: 292px; bottom: var(--space-4); display: none; }
.selection-panel--visible { display: flex; }
.selection-panel__content { padding: var(--space-3); }
.selection-panel__types { flex-direction: row; margin-bottom: var(--space-2); }
.selection-type { flex-direction: row; align-items: center; padding: 6px var(--space-2); margin: 0 var(--space-2) 0 0; background-color: var(--color-surface-raised); border-width: 2px; border-color: var(--color-border); border-top-color: var(--color-bevel-light); border-left-color: var(--color-bevel-light); border-bottom-color: var(--color-bevel-dark); border-right-color: var(--color-bevel-dark); border-radius: var(--radius-sm); }
.selection-type:hover { border-color: var(--color-text-primary); }
.selection-type > * { margin-right: 6px; }
.selection-type__count { color: var(--color-readout); -unity-font-style: normal; font-size: var(--font-size-14); }
.selection-panel__health { flex-direction: row; align-items: center; }
.selection-panel__health > * { margin-right: var(--space-2); }
.health-bar { width: 240px; height: 6px; background-color: var(--color-surface-raised); border-radius: var(--radius-sm); overflow: hidden; }
.health-bar__fill { height: 100%; width: 0; background-color: var(--color-success); border-radius: var(--radius-sm); }

/* Squad bar (Figma: Squad bar) */
.squad-bar { position: absolute; left: 292px; bottom: 142px; flex-direction: row; }
.squad-hint { position: absolute; left: 292px; bottom: 186px; font-size: var(--font-size-14); padding: 0; margin: 0; } /* Figma: v0.12 Fixes, Squad bar – hint states */
.squad { min-width: 30px; height: 38px; padding: 3px 10px; margin: 0 4px 0 0; align-items: center; justify-content: center; background-color: var(--color-surface-panel); border-width: 2px; border-color: var(--color-border); border-top-color: var(--color-bevel-light); border-left-color: var(--color-bevel-light); border-bottom-color: var(--color-bevel-dark); border-right-color: var(--color-bevel-dark); border-radius: var(--radius-sm); }
.squad:hover { border-color: var(--color-text-primary); }
.squad--active { border-color: var(--color-accent); }
.squad__key { font-size: var(--font-size-12); color: var(--color-text-secondary); padding: 0; }
.squad__count { font-size: var(--font-size-12); -unity-font-style: normal; color: var(--color-readout); padding: 0; }
.squad__count--empty { color: var(--color-text-disabled); }

/* HQ placement and countdown overlays (Figma: HUD / HQ placement, HUD / Countdown) */
.hud-overlay { position: absolute; left: 0; top: 0; right: 0; bottom: 0; align-items: center; display: none; }
.hud-overlay--visible { display: flex; }
.hud-overlay--top { padding-top: 80px; }
.hud-overlay--centre { justify-content: center; }
.hq-prompt { border-color: var(--color-accent); border-width: 2px; padding: 14px var(--space-6); align-items: center; }
.hq-prompt > * { margin-bottom: 6px; }
.hq-prompt__title { font-size: var(--font-size-20); -unity-font-style: normal; }
.countdown { padding: 20px 40px; align-items: center; }
/* Start option badges (Figma: HUD / HQ placement – timed pick, teammate's options) */
.start-markers { position: absolute; left: 0; top: 44px; right: 0; bottom: 0; }
.start-badge { position: absolute; flex-direction: row; align-items: center; padding: 1px 6px; border-width: 0; border-radius: 0; margin: 0; }
.start-badge__text { font-size: var(--font-size-16); color: var(--color-on-accent); padding: 0; margin: 0; -unity-font-style: bold; }
.countdown__label { font-size: var(--font-size-16); }
.countdown__value { font-size: 72px; }
.command-card--building { width: 440px; }

/* Exact Figma metrics for HUD panels (UI Toolkit's default label and button padding would add height). */
.panel__title { height: 33px; padding: 0 var(--space-3); margin: 0; -unity-text-align: middle-left; }
.selection-type { height: 38px; padding: 0 var(--space-2); }
.selection-type > Label, .selection-panel__health > Label, .production Label, .squad > Label { padding: 0; margin-top: 0; margin-bottom: 0; }
.selection-panel__health { height: 15px; }
.command-card .text--secondary { padding: 0; margin: 0; }

/* Minimap (Figma: Panel / Minimap) */
.minimap { position: absolute; left: var(--space-4); bottom: var(--space-4); width: 260px; }
.minimap__content { padding: var(--space-2); }
.minimap__frame { width: 244px; height: 244px; align-items: center; justify-content: center; background-color: #000000; border-width: 1px; border-color: var(--color-border); }
.minimap__image { width: 100%; height: 100%; overflow: hidden; }
.minimap__camera { position: absolute; border-width: 1px; border-color: var(--color-text-primary); }
.minimap__pings { position: absolute; left: 0; top: 0; right: 0; bottom: 0; }

/* Alert feed (Figma: v0.12 Fixes, HUD – alerts and squad hint): right side, above the command card (AlertFeedController sets bottom) */
.alert-column { position: absolute; right: var(--space-4); bottom: 212px; align-items: flex-end; } /* v0.15: the next-alert bar over the feed */
.alert-feed { align-items: flex-end; }
.next-alert-slot { align-items: flex-end; }
.alert { flex-direction: row; align-items: center; height: 34px; padding: 0 12px; margin-top: 6px; background-color: var(--color-surface-panel); border-width: 2px; border-color: var(--color-border); border-radius: var(--radius-sm); }
.alert__stripe { width: 4px; height: 20px; margin-right: 10px; }
.alert--danger .alert__stripe { background-color: var(--color-danger); }
.alert--warning .alert__stripe { background-color: var(--color-warning); }
.alert--accent .alert__stripe { background-color: var(--color-accent); }
.alert--success .alert__stripe { background-color: var(--color-success); }
/* Playtest 2026-10-30 (Figma "Playtest fixes" item 7): a 2 px bar in the stripe colour drains until the row leaves. */
.alert__timer { position: absolute; left: 0; bottom: 0; height: 2px; opacity: 0.7; }
.alert--danger .alert__timer { background-color: var(--color-danger); }
.alert--warning .alert__timer { background-color: var(--color-warning); }
.alert--accent .alert__timer { background-color: var(--color-accent); }
.alert--success .alert__timer { background-color: var(--color-success); }
.alert--new.alert--danger { border-color: var(--color-danger); }
.alert--new.alert--warning { border-color: var(--color-warning); }
.alert--new.alert--accent { border-color: var(--color-accent); }
.alert--new.alert--success { border-color: var(--color-success); }
.alert__text { font-size: var(--font-size-14); color: var(--color-text-primary); padding: 0; margin: 0 10px 0 0; }
.alert__dismiss { background-color: rgba(0, 0, 0, 0); border-width: 0; padding: 0 2px; margin: 0; font-size: var(--font-size-14); -unity-font-style: normal; color: var(--color-text-secondary); }
.alert__dismiss:hover { color: var(--color-text-primary); }
.alert--clickable:hover { border-color: var(--color-text-secondary); }

/* Order feedback tags (Figma: v0.12 Fixes, Orders – goal moved and queue full, Dig – drag an area); OrderTagsController places them */
.order-tag { position: absolute; display: none; padding: 3px 8px; margin: 0; font-size: var(--font-size-12); color: var(--color-warning); background-color: var(--color-surface-panel); border-width: 1px; border-color: var(--color-warning); border-radius: var(--radius-sm); }
.order-number { position: absolute; padding: 0; margin: 0; font-size: var(--font-size-12); color: var(--color-text-primary); -unity-text-outline-width: 1px; -unity-text-outline-color: rgba(0, 0, 0, 0.8); }

/* Minimap pings */
.minimap-ping { position: absolute; width: 22px; height: 22px; margin-left: -11px; margin-top: -11px; border-width: 2px; border-color: var(--color-danger); border-radius: 11px; }
.minimap-ping--warning { border-color: var(--color-warning); }
/* v0.16 fights on the minimap (Figma C): scale and opacity set per frame from code */
.minimap-pulse { position: absolute; width: 22px; height: 22px; margin-left: -11px; margin-top: -11px; border-width: 2px; border-radius: 11px; border-color: rgb(255, 255, 255); background-color: rgba(0, 0, 0, 0); }
.minimap-pulse--own { border-color: var(--color-danger); }
/* v0.16 HQ-placement minimap (Figma P): own option rings sized from code (PlacementMinimap/MarkerPixels), numbered */
.minimap-start { position: absolute; border-width: 2px; border-radius: 50%; background-color: rgba(0, 0, 0, 0); }
.minimap-start__label { position: absolute; padding: 0 3px; font-size: var(--font-size-12); color: rgb(10, 12, 16); -unity-font-style: bold; }
.minimap-start--teammate { width: 7px; height: 7px; margin-left: -3.5px; margin-top: -3.5px; border-width: 1.5px; }

/* Diplomacy panel (Figma: Panel / Diplomacy) */
.diplomacy-panel { position: absolute; right: var(--space-4); top: 60px; width: 400px; display: none; }
.diplomacy-panel--open { display: flex; }
.diplomacy-panel__content { padding: var(--space-3); }
.diplomacy-row { flex-direction: row; align-items: center; min-height: 20px; margin-bottom: var(--space-2); }
.diplomacy-row > * { margin-right: var(--space-3); }
.diplomacy-row--header { align-items: flex-start; }
.diplomacy-row__spacer { width: 10px; }
.diplomacy-row__name { width: 200px; padding: 0; }
.diplomacy-row__column { width: 63px; padding: 0; margin-right: var(--space-3); white-space: normal; }
.diplomacy-row__shares { font-size: var(--font-size-12); color: var(--color-accent); padding: 0; }
.diplomacy-row .text { padding: 0; }
.diplomacy-panel__note { padding: 0; margin-top: 4px; }
.switch { flex-direction: row; align-items: center; width: 63px; height: 20px; padding: 0; margin: 0 var(--space-3) 0 0; background-color: rgba(0, 0, 0, 0); border-width: 0; }
.switch__track { width: 36px; height: 20px; padding: 2px; border-radius: 10px; border-width: 1px; border-color: var(--color-border); background-color: var(--color-surface-raised); justify-content: center; }
.switch__knob { width: 16px; height: 16px; border-radius: 8px; background-color: var(--color-text-secondary); }
.switch--on .switch__track { background-color: var(--color-accent); align-items: flex-end; }
.switch--on .switch__knob { background-color: var(--color-on-accent); }
.switch__label { font-size: var(--font-size-14); color: var(--color-text-primary); padding: 0; margin-left: var(--space-2); }
.switch:disabled .switch__track { background-color: var(--color-surface-raised); }
.switch:disabled .switch__knob { background-color: var(--color-text-disabled); }
.switch:disabled .switch__label { color: var(--color-text-disabled); }
.top-bar__actions > .top-bar__hidden { display: none; }
.switch { width: auto; min-width: 63px; overflow: visible; }
.switch:hover, .switch:active, .switch:disabled { background-color: rgba(0, 0, 0, 0); border-width: 0; }
.diplomacy-panel__note { white-space: normal; }

/* ---------- Menus (Figma: Menus page) ---------- */
.menu-screen { position: absolute; left: 0; top: 0; right: 0; bottom: 0; display: none; }
.menu-screen--visible { display: flex; }
.menu-screen--centre { align-items: center; justify-content: center; }
.row { flex-direction: row; align-items: center; }
.row > * { margin-right: var(--space-2); }
.divider { height: 1px; background-color: var(--color-border); margin: var(--space-1) 0; }
.text--danger { color: var(--color-danger); white-space: normal; }
.text--warning { color: var(--color-warning); }
.button { -unity-text-align: middle-center; }
.button--primary:hover { background-color: var(--color-accent); color: var(--color-on-accent); }
.button--primary:disabled { background-color: var(--color-surface-raised); color: var(--color-text-disabled); }

/* Inputs (Figma: Components, Input) */
.input { width: 220px; }
.input__label { font-size: var(--font-size-12); color: var(--color-text-secondary); padding: 0; margin: 0 0 4px 0; }
.input__field { margin: 0; }
.input__field > .unity-base-text-field__input { height: 32px; padding: 0 12px; background-color: var(--color-surface-base); border-width: 1px; border-color: var(--color-border); border-radius: var(--radius-sm); color: var(--color-text-primary); font-size: var(--font-size-14); -unity-text-align: middle-left; }
.input__field:focus > .unity-base-text-field__input { border-color: var(--color-accent); border-width: 2px; }
.input__field:disabled > .unity-base-text-field__input { background-color: var(--color-surface-panel); color: var(--color-text-disabled); }
.input--error .input__field > .unity-base-text-field__input { border-color: var(--color-danger); border-width: 2px; }
.input__message { display: none; font-size: var(--font-size-12); color: var(--color-danger); padding: 0; margin: 4px 0 0 0; }
.input--error .input__message { display: flex; }

/* Main menu */
.main-menu__title { position: absolute; top: 300px; left: 0; right: 0; align-items: center; }
.main-menu__name { font-size: 72px; -unity-font-style: normal; color: var(--color-text-primary); padding: 0; }
.main-menu__buttons { position: absolute; top: 500px; left: 0; right: 0; align-items: center; }
.menu-button { width: 240px; height: 35px; margin-bottom: var(--space-2); }

/* Play (host or join) */
.play-panel { width: 560px; }
.play-panel__content { padding: 20px; }
.play-panel__content > * { margin-bottom: var(--space-3); }
.play-panel__heading { font-size: var(--font-size-16); -unity-font-style: normal; padding: 0; }
.play-panel__state { display: none; }
.play-panel__state--visible { display: flex; }
.play-panel .text--secondary { padding: 0; }
.play-panel__section { display: flex; }
.play-panel__section > * { margin-bottom: var(--space-3); }
.play-panel__header { justify-content: space-between; }
.play-panel__grow { flex-grow: 1; }
.play-panel__list > * { margin-bottom: var(--space-2); }
.play-panel__toggle { align-self: flex-start; }
.game-row { background-color: var(--color-surface-raised); border-width: 1px; border-color: var(--color-border); padding: 8px 12px; align-items: center; }
.game-row__name { flex-grow: 1; }
.game-row__meta { color: var(--color-text-secondary); }
.play-panel__notice { display: none; padding: 12px; border-width: 1px; border-color: var(--color-border); background-color: var(--color-surface-base); white-space: normal; }
.play-panel__notice--visible { display: flex; }
.play-panel__notice--warning { border-width: 2px; border-color: var(--color-warning); color: var(--color-warning); }
.play-panel__notice--danger { border-width: 2px; border-color: var(--color-danger); color: var(--color-danger); }

/* Lobby */
.lobby { background-color: var(--color-surface-base); }
/* v0.16 lobby (Figma M2, drawn at 1280 × 720, here at the 1920 reference): players in two columns of cards, the map, the settings in three blocks */
.lobby__heading { position: absolute; left: 50px; top: 44px; align-items: flex-end; }
.lobby__title { font-size: var(--font-size-28); -unity-font-style: normal; color: var(--color-text-primary); padding: 0; margin-right: 24px; }
.lobby__subtitle { padding: 0 0 4px 0; }
/* Playtest 2026-11-02 (Figma K1/K2): the host's server name, the player menu, the Ban confirmation */
.lobby__server-name { margin-left: 24px; align-items: center; padding: 4px 10px; border-width: 1px; border-color: var(--color-accent); background-color: var(--color-surface-raised); }
.lobby__server-name-label { padding: 0; margin-right: 8px; font-size: var(--font-size-12); }
.lobby__server-name-field { width: 260px; margin: 0; }
.lobby-card__menu { width: 30px; height: 24px; padding: 0; margin: 0 10px 0 0; border-width: 1px; border-color: var(--color-border); border-radius: var(--radius-sm); background-color: rgba(0, 0, 0, 0); color: var(--color-text-secondary); -unity-text-align: middle-center; }
.lobby-card__menu:hover { border-color: var(--color-accent); color: var(--color-accent); }
.lobby__confirm { width: 520px; }
.lobby__confirm-content { padding: var(--space-4); }
.lobby__confirm-text { white-space: normal; margin-bottom: var(--space-3); }
.lobby__confirm-buttons > * { margin-right: var(--space-3); }
.play-panel__removed { align-items: center; margin-bottom: var(--space-3); }
.lobby__column-title { font-size: var(--font-size-16); color: var(--color-text-primary); padding: 0; margin-bottom: 12px; }
.lobby__left { position: absolute; left: 50px; top: 138px; bottom: 96px; width: 946px; }
.lobby__left .unity-scroller--vertical { width: 6px; margin-left: 10px; border-width: 0; }
.lobby__left .unity-scroller--vertical .unity-base-slider__tracker { background-color: var(--color-surface-panel); border-width: 0; }
.lobby__left .unity-scroller--vertical .unity-base-slider__dragger { background-color: var(--color-border); border-width: 0; left: 0; width: 6px; }
.lobby__left .unity-scroller__low-button, .lobby__left .unity-scroller__high-button { display: none; }
.lobby__cards { flex-direction: row; flex-wrap: wrap; width: 930px; }
.lobby-card { width: 450px; height: 90px; flex-direction: row; align-items: center; margin: 0 15px 15px 0; padding-right: 18px; background-color: var(--color-surface-panel); border-width: 1px; border-color: var(--color-border); }
.lobby-card--you { border-color: var(--color-accent); }
.lobby-card__strip { width: 12px; height: 100%; padding: 0; margin: 0 18px 0 0; border-width: 0; border-radius: 0; }
Button.lobby-card__strip:hover { border-width: 0 2px 0 0; border-color: var(--color-text-primary); }
.lobby-card__info { flex-grow: 1; flex-shrink: 1; }
.lobby-card__name { font-size: var(--font-size-16); color: var(--color-text-primary); padding: 0; margin-bottom: 4px; }
.lobby-card__sub { flex-direction: row; align-items: center; }
.lobby-card__sub-text { font-size: var(--font-size-12); color: var(--color-text-secondary); padding: 0; margin: 0 6px 0 0; }
.lobby-card__side { align-items: flex-end; }
.lobby-card__side > * { margin: 0 0 4px 0; }
.lobby-card__remove { position: absolute; right: 4px; top: 4px; }
.lobby__pickers { width: 915px; }
.lobby__label { padding: 0; margin: var(--space-2) 0 6px 0; }
.lobby-row { flex-direction: row; align-items: center; height: 39px; padding: 0 var(--space-3); margin-bottom: 6px; background-color: var(--color-surface-panel); border-width: 1px; border-color: var(--color-border); border-radius: var(--radius-sm); }
.lobby-row--ready { background-color: var(--color-surface-raised); }
.lobby-row__swatch { width: 14px; height: 14px; border-radius: 0; margin-right: 10px; }
.lobby-row__name { flex-grow: 1; font-size: var(--font-size-14); -unity-font-style: normal; color: var(--color-text-primary); padding: 0; }
.lobby-row__team { height: 21px; padding: 0 var(--space-2); margin: 0 10px 0 0; border-width: 1px; border-color: var(--color-border); border-radius: var(--radius-sm); background-color: rgba(0, 0, 0, 0); font-size: var(--font-size-12); color: var(--color-text-secondary); }
.lobby-row__team:hover { border-color: var(--color-text-primary); background-color: rgba(0, 0, 0, 0); }
.lobby-row__ready { font-size: var(--font-size-12); -unity-font-style: normal; color: var(--color-text-secondary); padding: 0; min-width: 57px; -unity-text-align: middle-right; }
.lobby-row__ready--yes { color: var(--color-success); }
.lobby__colours > * { margin-right: 6px; }
.colour-chip { width: 28px; height: 28px; padding: 0; margin: 0 6px 0 0; border-width: 1px; border-color: var(--color-border); border-radius: var(--radius-sm); font-size: var(--font-size-16); -unity-font-style: normal; color: var(--color-surface-base); -unity-text-align: middle-center; }
.colour-chip--mine { border-width: 2px; border-color: var(--color-text-primary); }
.segmented > * { margin-right: 4px; }
.lobby__settings { position: absolute; left: 1500px; right: 50px; top: 138px; bottom: 96px; }
.lobby__block { margin-bottom: 15px; flex-shrink: 0; }
.lobby__block-content { padding: var(--space-3) var(--space-4); }
.lobby__block-content > * { margin-bottom: var(--space-3); }
.lobby__block .segmented { flex-wrap: wrap; }
.lobby__settings .unity-scroller--vertical { width: 6px; margin-left: 10px; border-width: 0; }
.lobby__settings .unity-scroller--vertical .unity-base-slider__tracker { background-color: var(--color-surface-panel); border-width: 0; }
.lobby__settings .unity-scroller--vertical .unity-base-slider__dragger { background-color: var(--color-border); border-width: 0; left: 0; width: 6px; }
.lobby__settings .unity-scroller__low-button, .lobby__settings .unity-scroller__high-button { display: none; }
.lobby__mode-row { align-items: flex-end; }
.lobby__mode-row > * { margin-right: 32px; }
.lobby__diplomacy { padding-bottom: 7px; }
.lobby__diplomacy .switch { width: auto; }
.lobby__preview { position: absolute; left: 1016px; top: 138px; width: 450px; }
.lobby__preview > * { margin-bottom: var(--space-3); }
.lobby__preview-image { width: 450px; height: 450px; background-color: var(--color-surface-raised); border-width: 12px; border-color: var(--color-surface-panel); }
.lobby__map-caption { padding: 0; color: var(--color-text-primary); }
.lobby__markers { position: absolute; left: 0; top: 0; right: 0; bottom: 0; }
.spawn-marker { position: absolute; width: 20px; height: 20px; margin-left: -10px; margin-top: -10px; border-radius: 10px; border-width: 2px; border-color: var(--color-surface-base); background-color: var(--color-text-secondary); }
.spawn-marker--free:hover { border-color: var(--color-accent); }
.spawn-marker--mine { width: 26px; height: 26px; margin-left: -13px; margin-top: -13px; border-radius: 13px; border-width: 3px; border-color: var(--color-text-primary); }
.spawn-marker__you { position: absolute; left: 30px; top: 3px; padding: 0; font-size: var(--font-size-12); -unity-font-style: normal; color: var(--color-text-primary); }
.spawn-marker__tooltip { display: none; position: absolute; left: 24px; top: -4px; padding: 4px 8px; border-width: 1px; border-color: var(--color-accent); border-radius: var(--radius-sm); background-color: var(--color-surface-base); font-size: var(--font-size-12); color: var(--color-text-primary); white-space: nowrap; }
.spawn-marker--free:hover > .spawn-marker__tooltip { display: flex; }
.lobby__hint { white-space: normal; margin-top: 4px; }
.lobby__seed { width: 200px; }
.lobby__settings-header { justify-content: space-between; align-items: center; }
.lobby__reroll { height: 35px; align-self: flex-start; }
.lobby__footer { position: absolute; left: 50px; bottom: 34px; }
.lobby__footer > * { margin-right: var(--space-3); }
.lobby__status { padding: 0; }
.hidden { display: none; }

/* ---------- In-match menu, surrender, gift dialog, end screen (Figma: Menus, HUD states) ---------- */
.button--danger { background-color: var(--color-danger); color: var(--color-on-accent); border-width: 0; }
.button--danger:hover { background-color: var(--color-danger); border-width: 1px; border-color: var(--color-text-primary); }
.button--danger:disabled { background-color: var(--color-surface-panel); color: var(--color-text-disabled); border-width: 1px; border-color: var(--color-border); }
.overlay-screen { position: absolute; left: 0; top: 0; right: 0; bottom: 0; display: none; align-items: center; justify-content: center; background-color: rgba(0, 0, 0, 0.5); }
.overlay-screen--visible { display: flex; }

/* v0.16 menu motion (Figma M1): an arriving screen slides and fades in, an overlay rises and its panel scales in from
   96 %; menu buttons lift on hover and press down. Reduce motion (on the root) makes every one an instant swap. */
.menu-screen { transition-property: translate, opacity; transition-duration: 200ms; transition-timing-function: ease-out; }
.menu-screen--enter { translate: 24px 0; opacity: 0; }
.menu-screen--enter-back { translate: -24px 0; opacity: 0; }
.overlay-screen { transition-property: opacity; transition-duration: 180ms; transition-timing-function: ease-out; }
.overlay-screen > * { transition-property: scale, translate; transition-duration: 180ms; transition-timing-function: ease-out; }
.overlay-screen--enter { opacity: 0; }
.overlay-screen--enter > * { scale: 0.96 0.96; translate: 0 12px; }
.menu-screen .button, .overlay-screen .button { transition-property: translate, background-color; transition-duration: 80ms; }
.menu-screen .button:hover, .overlay-screen .button:hover { translate: 0 -1px; }
.menu-screen .button:active, .overlay-screen .button:active { translate: 0 1px; }
.menu-screen .button:disabled, .overlay-screen .button:disabled { translate: 0 0; }
.reduce-motion .menu-screen, .reduce-motion .overlay-screen, .reduce-motion .overlay-screen > *, .reduce-motion .button { transition-duration: 0s; }
.match-menu { width: 320px; }
.match-menu__content { padding: 20px; }
.match-menu__content > * { margin-bottom: var(--space-2); }
.match-menu__button { width: 278px; height: 35px; }
.match-menu__paused { display: none; flex-direction: row; align-items: center; width: 278px; padding: 6px 10px; background-color: var(--color-surface-raised); border-width: 1px; border-color: var(--color-warning); }
.in-match-menu--paused .match-menu__paused { display: flex; }
.match-menu__paused-title { color: var(--color-warning); font-size: 22px; padding: 0; margin-right: var(--space-2); }
.match-menu__paused-text { padding: 0; }
.match-menu__note { width: 278px; white-space: normal; }
.surrender { width: 400px; display: none; }
.surrender__content { padding: 20px; }
.surrender__content > * { margin-bottom: var(--space-3); }
.surrender__text { white-space: normal; padding: 0; }
.in-match-menu--confirm .match-menu { display: none; }
.in-match-menu--confirm .surrender { display: flex; }
.gift-dialog { position: absolute; right: var(--space-4); top: 60px; width: 380px; display: none; }
.gift-dialog--open { display: flex; }
.gift-dialog__content { padding: var(--space-3); }
.gift-dialog__content > * { margin-bottom: 10px; }
.gift-dialog__label { padding: 0; }
.list-row { flex-direction: row; align-items: center; width: 280px; height: 36px; padding: 0 var(--space-3); margin: 0 0 10px 0; background-color: var(--color-surface-panel); border-width: 1px; border-color: rgba(0, 0, 0, 0); border-radius: var(--radius-sm); }
.list-row:hover { background-color: var(--color-surface-raised); }
.list-row--selected { background-color: var(--color-surface-raised); border-color: var(--color-accent); }
.list-row:disabled { background-color: var(--color-surface-panel); }
.list-row__swatch { width: 12px; height: 12px; border-radius: 0; margin-right: var(--space-2); }
.list-row__label { flex-grow: 1; font-size: var(--font-size-14); color: var(--color-text-primary); padding: 0; -unity-text-align: middle-left; }
.list-row__trailing { font-size: var(--font-size-12); color: var(--color-text-secondary); padding: 0; }
.list-row:disabled .list-row__label, .list-row:disabled .list-row__trailing { color: var(--color-text-disabled); }
.end-screen { background-color: var(--color-surface-base); justify-content: flex-start; }
.end-screen__result { margin-top: 160px; align-items: center; }
.end-screen__title { font-size: 56px; -unity-font-style: normal; padding: 0; color: var(--color-success); }
.end-screen__title--lose { color: var(--color-danger); }
.end-screen__title--draw { color: var(--color-text-primary); }
.end-screen__subtitle { font-size: var(--font-size-16); color: var(--color-text-secondary); padding: 0; margin-top: 4px; }
.end-screen__stats { margin-top: 69px; width: 1374px; }
.end-screen__buttons { margin-top: 32px; }
.end-screen__result--tabs { margin-top: 48px; }
.end-screen__tabs { margin-top: 12px; }
.end-screen__tabs > .button { margin-right: 4px; }
.end-screen__stats--tabs { margin-top: 16px; }
.end-screen__panel { margin-top: 16px; width: 1180px; padding: 12px; }
.summary-metrics { flex-direction: row; margin-bottom: 8px; }
.summary-metrics > .button { margin-right: 4px; }
.summary-chart { height: 390px; background-color: var(--color-surface-base); overflow: hidden; }
.summary-chart__axis { position: absolute; font-size: var(--font-size-12); color: var(--color-text-secondary); padding: 0; margin: 0; -unity-text-align: middle-right; width: 50px; }
.summary-chart__time { position: absolute; font-size: var(--font-size-12); color: var(--color-text-secondary); padding: 0; margin: 0; }
.summary-chart__readout { position: absolute; background-color: var(--color-surface-panel); border-width: 1px; border-color: var(--color-border); padding: 6px 10px 8px 10px; }
.summary-chart__readout-time { font-size: var(--font-size-14); color: var(--color-readout); padding: 0; margin: 0; }
.summary-readout-row { flex-direction: row; align-items: center; }
.summary-readout-row__name { font-size: var(--font-size-12); color: var(--color-text-secondary); width: 100px; padding: 0; margin: 0 0 0 8px; }
.summary-readout-row__name--you { color: var(--color-text-primary); }
.summary-readout-row__value { font-size: var(--font-size-12); color: var(--color-text-primary); width: 48px; -unity-text-align: middle-right; padding: 0; margin: 0; }
.summary-legend { flex-direction: row; flex-wrap: wrap; margin-top: 8px; }
.summary-legend__entry { flex-direction: row; align-items: center; padding: 3px 8px 4px 6px; margin-right: 6px; margin-bottom: 4px; background-color: var(--color-surface-raised); border-width: 1px; border-color: transparent; }
.summary-legend__entry--off { background-color: transparent; border-color: var(--color-border); }
.summary-legend__name { font-size: var(--font-size-12); color: var(--color-text-primary); padding: 0; margin: 0 0 0 6px; }
.summary-legend__entry--off .summary-legend__name { color: var(--color-text-disabled); }
.summary-legend__entry--off .swatch { background-color: var(--color-text-disabled); }
.timeline-row { flex-direction: row; align-items: center; padding: 6px 4px; }
.timeline-row__time { font-size: var(--font-size-16); color: var(--color-readout); width: 56px; padding: 0; margin: 0; }
.timeline-row__mark { width: 24px; height: 16px; }
.timeline-row__text { font-size: var(--font-size-16); color: var(--color-text-primary); flex-grow: 1; flex-shrink: 1; white-space: normal; padding: 0; margin: 0; }
.timeline-row__players { flex-direction: row; }
.timeline-row__players > .swatch { margin-left: 4px; }
.stats-row { flex-direction: row; align-items: center; height: 40px; padding: 0 16px; }
.stats-row--header { background-color: var(--color-surface-raised); }
.stats-cell { width: 100px; flex-direction: row; justify-content: flex-end; align-items: center; }
.stats-cell--narrow { width: 80px; }
.stats-cell--player { width: 400px; justify-content: flex-start; }
.stats-cell > Label { padding: 0; margin: 0; }
.stats-cell__head { font-size: var(--font-size-12); -unity-font-style: normal; color: var(--color-text-secondary); }
.stats-cell__value { font-size: var(--font-size-14); color: var(--color-readout); }
.stats-cell > .stats-cell__name { font-size: var(--font-size-14); -unity-font-style: normal; color: var(--color-text-primary); margin: 0 8px; }
.stats-cell__result { font-size: var(--font-size-12); color: var(--color-text-secondary); }
.stats-cell__result--win { color: var(--color-success); }

/* ---------- Settings (Figma: Settings page) ---------- */
.settings-screen { background-color: var(--color-surface-base); }
/* Pinned from the top, not centred: the pages differ in height, and a centred panel moved its title and tabs whenever the tab changed (owner request, 2026-10-10). 14% keeps the tallest state (a binding conflict) on screen. */
.settings { width: 760px; position: absolute; top: 14%; left: 50%; translate: -50% 0; }
.settings__content { padding: 20px 24px; }
.settings__divider { margin: var(--space-2) 0; }
.settings__page { display: none; }
.settings__page--visible { display: flex; }
.settings-row { flex-direction: row; align-items: center; justify-content: space-between; min-height: 32px; margin-bottom: var(--space-2); }
.settings-row__label { flex-grow: 1; padding: 0; }
.settings__heading { padding: 0; margin: var(--space-2) 0; }
.settings__palettes > * { margin-right: var(--space-3); }
.palette-card { width: 184px; padding: 12px 14px; margin: 0; align-items: flex-start; background-color: var(--color-surface-panel); border-width: 1px; border-color: var(--color-border); border-radius: var(--radius-lg); }
.palette-card--selected { border-color: var(--color-accent); border-width: 2px; }
.palette-card:hover { background-color: var(--color-surface-raised); }
.palette-card__name { font-size: var(--font-size-14); color: var(--color-text-primary); padding: 0; margin-bottom: 8px; }
.palette-card__swatches { flex-direction: row; margin-bottom: 8px; }
.palette-card__swatch { width: 16px; height: 16px; margin-right: 4px; border-radius: 0; }
.swatch--accent { background-color: var(--color-accent); }
.swatch--readout { background-color: var(--color-readout); }
.swatch--success { background-color: var(--color-success); }
.swatch--warning { background-color: var(--color-warning); }
.swatch--danger { background-color: var(--color-danger); }
.slider { flex-direction: row; align-items: center; width: 216px; }
.slider__track { width: 160px; height: 4px; border-radius: 0; background-color: var(--color-surface-raised); margin: 0 12px; }
.slider__fill { position: absolute; left: 0; top: 0; bottom: 0; background-color: var(--color-accent); border-radius: 0; }
.slider__knob { position: absolute; top: -5px; width: 14px; height: 14px; margin-left: -7px; border-radius: 7px; background-color: var(--color-text-primary); }
.slider__value { font-size: var(--font-size-12); color: var(--color-readout); padding: 0; min-width: 34px; -unity-text-align: middle-right; }
.binding { width: 140px; height: 26px; padding: 0; margin: 0; background-color: var(--color-surface-base); border-width: 1px; border-color: var(--color-border); border-radius: var(--radius-sm); font-size: var(--font-size-12); color: var(--color-readout); -unity-text-align: middle-center; }
.binding:hover { border-color: var(--color-text-primary); background-color: var(--color-surface-base); }
.binding--listening { background-color: var(--color-surface-raised); border-color: var(--color-accent); border-width: 2px; color: var(--color-accent); }
.binding--conflict { border-color: var(--color-danger); border-width: 2px; color: var(--color-danger); }
.binding--fixed { color: var(--color-readout); }
.settings__hint { padding: 0; margin: 4px 0; color: var(--color-accent); }
.settings__conflict { display: none; padding: 12px 13px; margin: var(--space-2) 0; background-color: var(--color-surface-raised); border-width: 1px; border-color: var(--color-danger); border-radius: var(--radius-md); }
.settings__conflict--visible { display: flex; }
.settings__conflict > * { margin-bottom: 8px; }
.settings__footer { margin-top: 12px; }

/* v0.10 replays (Figma: v0.10 Insight) */
.replays__blurb { white-space: normal; }
.replays__scroll { max-height: 400px; }
.replay-row__info { flex-grow: 1; }
.replay-row__meta { color: var(--color-text-secondary); }
.replay-row__size { margin-right: var(--space-3); }
.replay-viewer { justify-content: space-between; align-items: center; padding: 16px; }
.replay-viewer__bar { padding: 10px 16px; }
.replay-viewer__bar > * { margin-right: 16px; }
.replay-viewer__player { flex-direction: row; align-items: center; }
.replay-viewer__player > * { margin-right: 8px; }
.replay-viewer__speed > * { margin-right: 4px; }
.replay-viewer__seek { width: 560px; height: 8px; background-color: var(--color-surface-raised); }
.replay-viewer__marks { position: absolute; left: 0; right: 0; top: 0; bottom: 0; }
.replay-viewer__mark { position: absolute; top: -16px; width: 8px; height: 14px; }
.replay-viewer__mark-icon { width: 16px; height: 16px; margin-left: -8px; -unity-background-scale-mode: scale-to-fit; }
.replay-viewer__mark-bar { position: absolute; left: 0; top: 13px; height: 3px; background-color: var(--color-readout); }
.replay-viewer__player--viewed { border-width: 1px; border-color: var(--color-accent); background-color: var(--color-surface-raised); padding: 2px 6px; }
.replay-viewer__graphs { position: absolute; top: 72px; right: 16px; width: 640px; padding: 10px; }
.replay-viewer__graphs .summary-chart { height: 230px; }
.replay-viewer__view-list { position: absolute; bottom: 72px; right: 96px; padding: 6px; }
.replay-viewer__view-list > .button { margin-bottom: 2px; }
.replay-viewer__tip { position: absolute; bottom: 88px; padding: 6px 10px; }
.replay-viewer__note { position: absolute; bottom: 72px; right: 96px; padding: 8px 12px; color: var(--color-readout); white-space: normal; width: 340px; }
.replay-viewer__seek-fill { position: absolute; left: 0; top: 0; bottom: 0; width: 0; background-color: var(--color-accent); }
.replay-viewer__seek-knob { position: absolute; top: -4px; width: 4px; height: 16px; left: 0; background-color: var(--color-text-primary); }
.replay-viewer__time { min-width: 110px; -unity-text-align: middle-right; }
.end-screen__replay { margin-top: 32px; align-items: center; display: none; }
.end-screen__replay--visible { display: flex; }
.end-screen__replay-bar { width: 320px; height: 6px; margin-top: 8px; background-color: var(--color-surface-raised); }
.end-screen__replay-fill { position: absolute; left: 0; top: 0; bottom: 0; width: 0; background-color: var(--color-accent); }

/* v0.12 Arsenal (Figma page v0.12 Arsenal): the producers' type selector, its info line and hover card, and the selection chips' unit icons. */
.production__types { margin-top: var(--space-2); }
.production__info { margin-top: var(--space-2); padding: 0; }
.production__tooltip { display: none; position: absolute; left: 60px; top: 70px; padding: 8px 10px; background-color: var(--color-surface-raised); border-width: 1px; border-color: var(--color-border); }
.production__tooltip--open { display: flex; }
.production__tooltip > Label { padding: 0; margin: 0 0 4px 0; }
.production__warning { color: var(--color-warning); }
.selection-type .command-icon { width: 24px; height: 24px; }

/* v0.13 Bastion (Figma page v0.13 Bastion): the Builders' build area in two rows by role, the hover card every build button shares, and the selected building's Upkeep and status lines. */
.command-card__builds { position: relative; }
.command-card__row--second { margin-top: var(--space-2); }
.build-tooltip { display: none; position: absolute; translate: -50% -100%; padding: 8px 10px; background-color: var(--color-surface-raised); border-width: 1px; border-color: var(--color-border); }
.build-tooltip--open { display: flex; }
.build-tooltip > Label { padding: 0; margin: 0 0 4px 0; white-space: nowrap; }
.selection-panel__upkeep { flex-direction: row; margin-top: var(--space-2); }
.selection-panel__upkeep > Label { padding: 0; margin: 0 var(--space-2) 0 0; }
.selection-upkeep--unpaid { color: var(--color-warning); }
.selection-status { padding: 0; margin: var(--space-2) 0 0 0; color: var(--color-success); }
.selection-status--danger { color: var(--color-danger); }
.selection-status--idle { color: var(--color-text-secondary); }

/* v0.14 AI opponents (Figma page v0.14 AI opponents, approved 2026-10-23): the AI tag every player name shares, the lobby's AI rows, Add AI and Visibility. */
.player-name { flex-direction: row; align-items: center; }
.player-name > Label { padding: 0; margin: 0; }
.ai-tag { flex-direction: row; align-items: center; margin-left: 8px; flex-shrink: 0; }
.ai-tag__icon { width: 16px; height: 16px; margin-right: 4px; flex-shrink: 0; }
.ai-tag__label { font-size: var(--font-size-12); color: var(--color-text-secondary); padding: 0; margin: 0; }
.player-name--disabled .ai-tag__label { color: var(--color-text-disabled); }
.player-name--disabled .ai-tag__icon { -unity-background-image-tint-color: var(--color-text-disabled); }
.top-bar__player .ai-tag { margin-left: 4px; }
.list-row__label .player-name__text { font-size: var(--font-size-14); color: var(--color-text-primary); }
.list-row:disabled .player-name__text, .list-row:disabled .ai-tag__label { color: var(--color-text-disabled); }
.stats-cell--player .player-name { margin: 0 8px; }
.stats-cell .player-name > .stats-cell__name { font-size: var(--font-size-14); -unity-font-style: normal; color: var(--color-text-primary); margin: 0; }
.alert__subject { margin-right: 0; }
.alert__tag { margin-right: 8px; }
.alert__tag .ai-tag__label { font-size: var(--font-size-14); }
.lobby-row__name-box { flex-grow: 1; flex-shrink: 1; }
.lobby-row__name-box .lobby-row__name { flex-grow: 0; }
.lobby-row__swatch-button { width: 14px; height: 14px; padding: 0; margin: 0 8px 0 0; border-width: 0; border-radius: 0; }
.lobby-row__swatch-button:hover { border-width: 1px; border-color: var(--color-text-primary); }
.lobby-row__pill { height: 21px; padding: 0 var(--space-2); margin: 0 8px 0 0; border-width: 1px; border-color: var(--color-border); border-radius: var(--radius-sm); background-color: rgba(0, 0, 0, 0); font-size: var(--font-size-12); color: var(--color-text-secondary); }
.lobby-row__pill:hover { border-color: var(--color-text-primary); background-color: rgba(0, 0, 0, 0); }
.lobby-row__text { font-size: var(--font-size-12); color: var(--color-text-secondary); padding: 0; margin: 0 10px 0 0; }
.lobby-row__remove { width: 25px; height: 21px; padding: 0; margin: 0 0 0 8px; border-width: 1px; border-color: var(--color-border); border-radius: var(--radius-sm); background-color: rgba(0, 0, 0, 0); font-size: var(--font-size-12); color: var(--color-text-primary); -unity-text-align: middle-center; }
.lobby-row__remove:hover { border-color: var(--color-danger); background-color: rgba(0, 0, 0, 0); }
.ai-row .lobby-row__ready { min-width: 30px; }
.lobby__add-ai { align-items: center; margin: 2px 0 var(--space-2) 0; }
.lobby__add-ai-hint { padding: 0; margin-left: 12px; }
.lobby__visibility-hint--warning { color: var(--color-warning); }
.unity-base-dropdown__container-outer { min-width: 120px; background-color: var(--color-surface-raised); border-width: 1px; border-color: var(--color-border); border-radius: var(--radius-sm); }
.unity-base-dropdown__container-inner { background-color: var(--color-surface-raised); border-width: 0; }
.unity-base-dropdown .unity-scroller--horizontal { display: none; }
.unity-base-dropdown__item { height: 24px; padding: 0 8px 0 4px; }
.unity-base-dropdown__item:hover { background-color: var(--color-surface-panel); }
.unity-base-dropdown__label { font-size: var(--font-size-12); color: var(--color-text-primary); }
.unity-base-dropdown__checkmark { -unity-background-image-tint-color: var(--color-accent); }
.diplomacy-row__name .player-name { flex-wrap: wrap; }

/* ---------- v0.15 QoL HUD (Figma: v0.15 QoL – redesign, node 116:2; docs/ux/v0.15-qol-figma.md) ---------- */
/* The shared hover card (command-tooltip, frame 3) and the key chip (component 120:402). */
.hover-card { position: absolute; display: none; flex-direction: column; min-width: 160px; max-width: 280px; padding: 10px 12px 4px 12px; background-color: var(--color-surface-base); border-width: 1px; border-color: var(--color-border); border-radius: var(--radius-sm); }
.hover-card--open { display: flex; }
.hover-card > * { margin: 0 0 6px 0; }
.hover-card__head { flex-direction: row; align-items: center; }
.hover-card__title { flex-grow: 1; flex-shrink: 1; font-size: var(--font-size-16); color: var(--color-text-primary); padding: 0; margin: 0 12px 0 0; white-space: normal; }
.key-chip { flex-direction: row; flex-shrink: 0; padding: 1px 6px; background-color: var(--color-surface-base); border-width: 1px; border-color: var(--color-border); border-radius: var(--radius-sm); }
.key-chip__text { font-size: var(--font-size-12); color: var(--color-readout); padding: 0; margin: 0; white-space: nowrap; }
.hover-card__role { font-size: var(--font-size-12); color: var(--color-text-primary); padding: 0; white-space: normal; }
.hover-card__pairs { flex-direction: row; flex-wrap: wrap; }
.hover-card__pair { flex-direction: row; align-items: flex-end; margin-right: 10px; }
.hover-card__label { font-size: var(--font-size-12); color: var(--color-text-secondary); padding: 0; margin: 0 4px 0 0; }
.hover-card__value { font-size: var(--font-size-12); color: var(--color-text-primary); padding: 0; margin: 0; }
.hover-card__value--cost { color: var(--color-readout); }
.hover-card__value--danger { color: var(--color-danger); }
.hover-card__line { font-size: var(--font-size-12); color: var(--color-text-secondary); padding: 0; margin: 0 0 6px 0; white-space: normal; }
.hover-card__line--gold { color: var(--color-readout); }
.hover-card__warning { font-size: var(--font-size-12); color: var(--color-warning); padding: 0; white-space: normal; }
.hover-card__reason { font-size: var(--font-size-12); color: var(--color-danger); padding: 0; white-space: normal; }

/* Top bar: net income as the main rate, income and upkeep as the breakdown (frame 4). */
.top-bar__net { font-size: var(--font-size-14); padding: 0; -unity-font-style: normal; }
.top-bar__net--healthy { color: var(--color-success); }
.top-bar__net--negative { color: var(--color-warning); }
.top-bar__net--danger { color: var(--color-danger); }
.top-bar__net-select { display: none; font-size: var(--font-size-12); color: var(--color-danger); padding: 0; }
.top-bar__net-select:hover { color: var(--color-text-primary); }
.top-bar__breakdown { font-size: var(--font-size-12); padding: 0; }
.top-bar__resources-value { padding: 0 4px; border-width: 1px; border-color: rgba(0, 0, 0, 0); }
.top-bar__resources-value--danger { border-color: var(--color-danger); }
/* Quick-select counts right of the resources (frame 1). */
.quick-select { flex-direction: row; align-items: center; margin-left: var(--space-3); }
.quick-select__chip { flex-direction: row; align-items: center; height: 29px; padding: 0 7px; margin: 0 4px 0 0; background-color: var(--color-surface-panel); border-width: 1px; border-color: var(--color-border); border-radius: var(--radius-sm); }
.quick-select__chip:hover { background-color: var(--color-surface-raised); border-color: var(--color-text-primary); }
.quick-select__chip--pulse { border-color: var(--color-readout); border-width: 2px; }
.quick-select__icon { width: 16px; height: 16px; margin-right: 6px; }
.quick-select__count { font-size: var(--font-size-14); color: var(--color-text-primary); padding: 0; margin: 0; }
.quick-select__count--gold { color: var(--color-readout); }
.quick-select__unit { font-size: var(--font-size-12); color: var(--color-text-secondary); padding: 0; margin: 0 0 0 3px; }
.quick-select__chip:disabled .quick-select__count, .quick-select__chip:disabled .quick-select__unit { color: var(--color-text-disabled); }
.quick-select__chip:disabled .command-icon { -unity-background-image-tint-color: var(--color-text-disabled); }
/* Jump to HQ, first in the actions row (frame 2). */
.top-bar__hq { flex-direction: row; align-items: center; }
.top-bar__hq-icon { width: 16px; height: 16px; margin-right: 6px; }
.top-bar__hq-label { font-size: var(--font-size-14); color: var(--color-text-primary); padding: 0; margin: 0; }
/* Reconnect (item 19): an away player's timer after the greyed name (TopBarController.SetAway). */
.top-bar__away { font-size: var(--font-size-12); color: var(--color-text-secondary); padding: 0; margin-left: 6px; }

/* Command card: the Rally point row with Rally all (frame 8). */
.production__rally { padding: var(--space-2) var(--space-3); background-color: var(--color-surface-raised); border-width: 1px; border-color: var(--color-border); }
.production__rally-text { flex-grow: 1; flex-shrink: 1; margin-right: var(--space-3); }
.production__rally-title { padding: 0; margin: 0 0 2px 0; }
.production__rally-text > Label { white-space: normal; }
.production__rally-all { width: 64px; margin: 0; }
.production__rally-all .command-button__key { white-space: nowrap; }

/* Selection panel: selected / on the map, and the Map-wide tag (frame 5). */
.selection-panel__title { flex-direction: row; align-items: center; }
.selection-panel__title-text { font-size: var(--font-size-14); color: var(--color-text-primary); padding: 0; margin: 0; }
.map-wide-tag { display: none; font-size: var(--font-size-12); color: var(--color-accent); padding: 0 6px; margin: 0 0 0 10px; border-width: 1px; border-color: var(--color-accent); }
.selection-type__total { font-size: var(--font-size-12); color: var(--color-text-secondary); padding: 0; margin: 0; }

/* Squad bar: a building group shows the producer's icon and count (frame 6). */
.squad__line { flex-direction: row; align-items: center; height: 15px; flex-shrink: 0; }
.squad__line > * { flex-shrink: 0; }
.squad__icon { width: 12px; height: 12px; margin-right: 2px; display: none; }
.squad__count--group { color: var(--color-text-primary); }

/* Minimap: eye popover and S/M/L in the title bar (frame 13). The frame's size is set by MinimapController. */
.minimap__title { flex-direction: row; align-items: center; padding-right: 6px; }
.minimap__title-text { flex-grow: 1; font-size: var(--font-size-14); color: var(--color-text-primary); padding: 0; margin: 0; }
.minimap__eye { width: 24px; height: 20px; padding: 0; margin: 0 6px 0 0; align-items: center; justify-content: center; background-color: var(--color-surface-base); border-width: 1px; border-color: var(--color-border); border-radius: var(--radius-sm); }
.minimap__eye:hover { border-color: var(--color-text-primary); }
.minimap__eye--filtered { border-color: var(--color-readout); }
.minimap__eye--open { background-color: var(--color-accent); }
.minimap__eye--open .command-icon { -unity-background-image-tint-color: var(--color-on-accent); }
.minimap__eye-icon { width: 16px; height: 16px; }
.minimap__scale { flex-direction: row; }
.minimap__size { width: 18px; height: 20px; padding: 0; margin: 0 0 0 2px; font-size: var(--font-size-12); color: var(--color-text-secondary); background-color: var(--color-surface-base); border-width: 1px; border-color: var(--color-border); border-radius: var(--radius-sm); -unity-text-align: middle-center; }
.minimap__size:hover { border-color: var(--color-text-primary); }
.minimap__size--on { background-color: var(--color-accent); color: var(--color-on-accent); }
.minimap-popover { position: absolute; display: none; width: 200px; padding: 10px 12px; background-color: var(--color-surface-base); border-width: 1px; border-color: var(--color-border); }
.minimap-popover--open { display: flex; }
.minimap-popover__title { padding: 0; margin: 0 0 6px 0; }
.minimap-popover__row { flex-direction: row; align-items: center; height: 24px; }
.minimap-popover__swatch { width: 10px; height: 10px; margin-right: 8px; }
.minimap-popover__swatch--small { width: 4px; height: 4px; margin: 3px 11px 3px 3px; }
.minimap-popover__label { flex-grow: 1; font-size: var(--font-size-12); color: var(--color-text-primary); padding: 0; margin: 0; }
.minimap-popover__label--off { color: var(--color-text-secondary); }
.minimap-popover__row .switch { min-width: 0; margin: 0; }
.minimap-popover__row .switch__label { display: none; }

/* Alert feed: the next-alert bar and visited rows (frame 11). */
.next-alert { flex-direction: row; align-items: center; height: 30px; padding: 0 8px; margin: 6px 0 0 0; background-color: var(--color-surface-panel); border-width: 2px; border-color: var(--color-border); border-radius: var(--radius-sm); }
.next-alert:hover { border-color: var(--color-text-primary); }
.next-alert > * { margin-right: 8px; }
.next-alert__text { font-size: var(--font-size-14); color: var(--color-text-primary); padding: 0; }
.next-alert__count { font-size: var(--font-size-12); color: var(--color-on-accent); background-color: var(--color-readout); padding: 0 6px; margin-right: 0; }
.alert--visited { opacity: 0.6; }

/* The HUD's cursor tag ("No idle Builders", "Rally all producers (4)"). */
.cursor-notice { color: var(--color-text-primary); border-color: var(--color-border); }

/* ---------- Field manual (v0.18, Figma F1-F3) ---------- */
.manual { background-color: rgba(0, 0, 0, 0.6); align-items: center; justify-content: center; }
.manual--full { background-color: var(--color-surface-base); }
.manual__window { width: 1160px; height: 660px; max-width: 96%; max-height: 96%; padding: 0; }
.manual--full .manual__window { width: 1280px; height: 720px; }
.manual__bar-top { flex-direction: row; align-items: center; padding: 10px 16px; background-color: var(--color-surface-raised); flex-shrink: 0; }
.manual__title { font-size: var(--font-size-28); color: var(--color-text-primary); flex-grow: 1; padding: 0; margin: 0; }
.manual__search { width: 300px; margin-right: 12px; }
.manual__body { flex-direction: row; flex-grow: 1; flex-shrink: 1; min-height: 0; }
.manual__nav { width: 184px; flex-shrink: 0; padding: 12px 8px; background-color: rgba(0, 0, 0, 0.14); }
.manual__nav > .button { margin-bottom: 4px; -unity-text-align: middle-left; }
.manual__scroll { flex-grow: 1; flex-shrink: 1; }
.manual__page { padding: 14px 22px 22px 22px; transition-property: translate, opacity; transition-duration: 200ms; transition-timing-function: ease-out; }
.manual__page--from-right { translate: 32px 0; opacity: 0; transition-duration: 0ms; }
.manual__page--from-left { translate: -32px 0; opacity: 0; transition-duration: 0ms; }
.manual__heading { font-size: var(--font-size-28); color: var(--color-text-primary); padding: 0; margin: 0 0 10px 0; }
.manual__sub { font-size: var(--font-size-20); color: var(--color-readout); padding: 0; margin: 14px 0 6px 0; }
.manual__lead { font-size: var(--font-size-16); color: var(--color-text-secondary); white-space: normal; padding: 0; margin: 0 0 10px 0; }
.manual__text { font-size: var(--font-size-16); color: var(--color-text-primary); white-space: normal; padding: 0; margin: 0 0 8px 0; }
.manual__note { font-size: var(--font-size-14); color: var(--color-text-secondary); white-space: normal; padding: 0; margin: 8px 0 0 0; }
.manual__role { font-size: var(--font-size-16); color: var(--color-text-secondary); padding: 0; margin: 0; }
.manual__cards { flex-direction: row; flex-wrap: wrap; }
.manual__card { width: 280px; flex-direction: column; align-items: stretch; padding: 10px 12px 12px 12px; margin: 0 12px 12px 0; background-color: var(--color-surface-raised); -unity-text-align: upper-left; }
.manual__card-name { font-size: var(--font-size-20); color: var(--color-text-primary); padding: 0; margin: 6px 0 2px 0; }
.manual__card-role { font-size: var(--font-size-14); color: var(--color-text-secondary); white-space: normal; padding: 0; margin: 0; }
.manual__art { align-items: center; justify-content: center; background-color: var(--color-surface-base); flex-shrink: 0; }
.manual__head { flex-direction: row; align-items: center; margin-bottom: 14px; }
.manual__head > .manual__art { margin-right: 16px; }
.manual__head .manual__heading { margin-bottom: 2px; }
.manual__split { flex-direction: row; align-items: flex-start; }
.manual__stats { width: 300px; flex-shrink: 0; background-color: var(--color-surface-base); padding: 6px 12px; margin-right: 22px; }
.manual__stat { flex-direction: row; justify-content: space-between; align-items: center; padding: 3px 0; border-bottom-width: 1px; border-color: rgba(82, 98, 122, 0.5); }
.manual__stat-label, .manual__bind-label { font-size: var(--font-size-16); color: var(--color-text-secondary); padding: 0; margin: 0; flex-shrink: 1; white-space: normal; }
.manual__stat-value { font-size: var(--font-size-16); color: var(--color-text-primary); -unity-text-align: middle-right; padding: 0; margin: 0 0 0 12px; flex-shrink: 0; }
.manual__prose { flex-grow: 1; flex-shrink: 1; min-width: 0; }
.manual__link { background-color: transparent; border-width: 0; padding: 0; margin: 0; color: var(--color-accent); font-size: var(--font-size-16); }
.manual__crumb { align-self: flex-start; margin-bottom: 8px; font-size: var(--font-size-14); }
.manual__damage-row { flex-direction: row; padding: 2px 0; border-bottom-width: 1px; border-color: rgba(82, 98, 122, 0.5); }
.manual__damage-name { width: 140px; font-size: var(--font-size-14); color: var(--color-text-primary); padding: 0; margin: 0; }
.manual__damage-cell { width: 90px; font-size: var(--font-size-14); color: var(--color-text-primary); -unity-text-align: middle-right; padding: 0; margin: 0; }
.manual__damage-row--head .manual__damage-name, .manual__damage-row--head .manual__damage-cell { color: var(--color-text-secondary); }
.manual__counters { flex-direction: row; flex-wrap: wrap; }
.manual__counters > * { margin-right: 24px; }
.manual__minis { flex-direction: row; flex-wrap: wrap; }
.manual__mini { flex-direction: row; align-items: center; padding: 3px 8px 3px 3px; margin: 0 6px 6px 0; background-color: var(--color-surface-raised); }
.manual__mini-name { font-size: var(--font-size-14); color: var(--color-text-primary); padding: 0; margin: 0 0 0 6px; }
.manual__mini .manual__art { width: 34px; height: 34px; }
.manual__grid-row { flex-direction: row; margin-bottom: 2px; }
.manual__grid-name { width: 170px; -unity-text-align: middle-left; padding: 3px 6px; margin: 0; flex-shrink: 0; }
.manual__grid-cell { width: 120px; font-size: var(--font-size-16); -unity-text-align: middle-center; padding: 3px 0; margin: 0 0 0 2px; flex-shrink: 0; }
.manual__grid-head { font-size: var(--font-size-14); color: var(--color-text-secondary); }
.manual__readout { font-size: var(--font-size-16); color: var(--color-readout); padding: 0; margin: 8px 0; }
.manual__heat-0 { background-color: #263039; color: var(--color-text-disabled); }
.manual__heat-1 { background-color: #3B3F46; color: var(--color-text-secondary); }
.manual__heat-2 { background-color: #574F3E; color: var(--color-text-primary); }
.manual__heat-3 { background-color: #7A6840; color: var(--color-text-primary); }
.manual__heat-4 { background-color: #A98A45; color: #1B1608; }
.manual__heat-5 { background-color: #D9AB4D; color: #1B1608; }
.manual__heat-6 { background-color: #FFC857; color: #1B1608; }
.manual__diagram { background-color: var(--color-surface-base); padding: 12px; margin-bottom: 12px; align-self: flex-start; }
.manual__diagram-text { font-size: var(--font-size-14); padding: 0; margin: 0; }
.manual__bar-row { flex-direction: row; align-items: center; margin-bottom: 8px; }
.manual__bar-label { width: 220px; font-size: var(--font-size-14); color: var(--color-text-secondary); padding: 0; margin: 0; }
.manual__bar { height: 20px; }
.manual__bar-value { font-size: var(--font-size-14); color: var(--color-text-primary); padding: 0; margin: 0 0 0 8px; }
.manual__step { width: 164px; height: 72px; margin-right: 12px; background-color: var(--color-surface-panel); border-width: 2px; border-color: var(--color-border); font-size: var(--font-size-14); color: var(--color-text-primary); white-space: normal; -unity-text-align: middle-center; padding: 4px; }
.manual__title-row { flex-direction: row; justify-content: space-between; align-items: flex-start; }
.reduce-motion .manual__page { transition-duration: 0ms; }
