<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <ui:VisualElement name="lobby" class="menu-screen lobby">
        <ui:VisualElement class="row lobby__heading">
            <ui:Label text="Lobby" class="lobby__title" />
            <ui:Label name="lobby-subtitle" text="" class="text text--muted lobby__subtitle" />
        </ui:VisualElement>
        <ui:ScrollView name="lobby-left" mode="Vertical" horizontal-scroller-visibility="Hidden" class="lobby__left">
            <ui:Label name="players-title" text="Players" class="lobby__column-title" />
            <ui:VisualElement name="lobby-cards">
                <ui:VisualElement name="player-rows" class="lobby__cards" />
            </ui:VisualElement>
            <ui:VisualElement name="add-ai-row" class="row lobby__add-ai">
                <ui:Button name="add-ai-button" text="Add AI" class="button" />
                <ui:Label name="add-ai-hint" text="AIs are always ready. Shown while a seat is free (8 at most)." class="text--secondary lobby__add-ai-hint" />
            </ui:VisualElement>
            <ui:VisualElement name="local-pickers" class="lobby__pickers">
                <ui:Label text="Your colour (taken colours are crossed out)" class="text--secondary lobby__label" />
                <ui:VisualElement name="colour-picker" class="row lobby__colours" />
                <ui:VisualElement name="team-section">
                    <ui:Label text="Your team" class="text--secondary lobby__label" />
                    <ui:VisualElement name="team-picker" class="row segmented" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:ScrollView>
        <ui:VisualElement class="lobby__preview">
            <ui:Label text="Map" class="lobby__column-title" />
            <ui:VisualElement name="preview-image" class="lobby__preview-image">
                <ui:VisualElement name="preview-markers" class="lobby__markers" picking-mode="Ignore" />
            </ui:VisualElement>
            <ui:Label name="lobby-map-caption" text="" class="text lobby__map-caption" />
            <ui:Button name="reroll-button" text="Reroll" class="button lobby__reroll" />
            <ui:Label name="start-caption" text="Terrain only. Start points are private: each player is dealt their own options when the match starts (teammates see each other's)." class="text--secondary lobby__caption" />
        </ui:VisualElement>
        <ui:ScrollView name="lobby-settings" mode="Vertical" horizontal-scroller-visibility="Hidden" class="lobby__settings">
            <ui:Label name="settings-title" text="Match settings" class="lobby__column-title" />
            <ui:VisualElement name="lobby-block-map" class="panel lobby__block">
                <ui:Label text="Map" class="panel__title" />
                <ui:VisualElement class="lobby__block-content">
                    <ui:VisualElement class="option-group">
                        <ui:Label text="Size" class="text--secondary lobby__label" />
                        <ui:VisualElement name="size-options" class="row segmented" />
                    </ui:VisualElement>
                    <ui:VisualElement class="input lobby__seed">
                        <ui:Label text="Seed" class="input__label" />
                        <ui:TextField name="seed-field" max-length="10" class="input__field" />
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement name="lobby-block-start" class="panel lobby__block">
                <ui:Label text="Start" class="panel__title" />
                <ui:VisualElement class="lobby__block-content">
                    <ui:VisualElement class="option-group">
                        <ui:Label text="Resources" class="text--secondary lobby__label" />
                        <ui:VisualElement name="resource-options" class="row segmented" />
                    </ui:VisualElement>
                    <ui:VisualElement class="option-group">
                        <ui:Label text="Options per player" class="text--secondary lobby__label" />
                        <ui:VisualElement name="start-options-row" class="row segmented" />
                        <ui:Label name="start-options-hint" text="" class="text--secondary lobby__hint" />
                    </ui:VisualElement>
                    <ui:VisualElement class="option-group">
                        <ui:Label text="HQ pick time" class="text--secondary lobby__label" />
                        <ui:VisualElement name="pick-time-row" class="row segmented" />
                        <ui:Label name="pick-time-hint" text="Random: HQs go down at once. Timed: the rest are placed at random when time runs out. Unlimited: the match waits for everyone." class="text--secondary lobby__hint" />
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement name="lobby-block-rules" class="panel lobby__block">
                <ui:Label text="Rules" class="panel__title" />
                <ui:VisualElement class="lobby__block-content">
                    <ui:VisualElement name="visibility-group" class="option-group">
                        <ui:Label text="Visibility" class="text--secondary lobby__label" />
                        <ui:VisualElement name="visibility-row" class="row segmented" />
                        <ui:Label name="visibility-hint" text="" class="text--secondary lobby__hint" />
                    </ui:VisualElement>
                    <ui:VisualElement class="row lobby__mode-row">
                        <ui:VisualElement class="option-group">
                            <ui:Label text="Mode" class="text--secondary lobby__label" />
                            <ui:VisualElement name="mode-options" class="row segmented" />
                        </ui:VisualElement>
                        <ui:VisualElement name="diplomacy-switch-slot" class="lobby__diplomacy" />
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:ScrollView>
        <ui:VisualElement class="row lobby__footer">
            <ui:Button name="leave-button" text="Leave" class="button" />
            <ui:Button name="ready-button" text="Ready" class="button button--primary" />
            <ui:Button name="start-button" text="Start match" class="button button--primary" />
            <ui:Button name="invite-button" text="Invite friends" class="button hidden" />
            <ui:Label name="lobby-status" text="" class="text lobby__status" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
