/* v0.15 item 19, reconnect after a drop (Figma page "v0.15 QoL – redesign": E1 124:15401, E2 124:15855, detail 135:1450).
   Used by Hud.uxml (banners, top-bar away tag) and HostJoin.uxml (the Rejoin card). Colours are Theme.uss tokens. */

/* Shared: the 32 px icon and the 3 px countdown bar. */
.reconnect-icon { width: 32px; height: 32px; flex-shrink: 0; margin-right: 12px; -unity-background-scale-mode: scale-to-fit; }
.reconnect-icon--small { width: 16px; height: 16px; flex-shrink: 0; margin-left: 6px; margin-right: 4px; -unity-background-scale-mode: scale-to-fit; }
.reconnect-bar { height: 3px; align-self: stretch; overflow: hidden; background-color: var(--color-surface-raised); }
.reconnect-bar__fill { height: 3px; background-color: var(--color-warning); }
.reconnect--danger .reconnect-bar__fill { background-color: var(--color-danger); }

/* In-match banners under the top bar (reconnect-banner, 135:1454). */
.reconnect-banners { position: absolute; left: 0; right: 0; top: 58px; align-items: center; }
.reconnect-banner { flex-direction: row; align-items: center; padding-right: 16px; margin-bottom: 8px; background-color: var(--color-surface-panel); border-width: 1px; border-color: var(--color-border); overflow: hidden; }
.reconnect-banner__stripe { width: 4px; height: 52px; margin-right: 12px; background-color: var(--color-warning); }
.reconnect--success .reconnect-banner__stripe { background-color: var(--color-success); }
.reconnect--danger .reconnect-banner__stripe { background-color: var(--color-danger); }
.reconnect-banner__body { padding: 8px 0; }
.reconnect-banner__line { flex-direction: row; align-items: center; margin-bottom: 4px; }
.reconnect-banner__line .swatch { margin-right: 6px; }
.reconnect-banner__title { font-size: var(--font-size-16); color: var(--color-text-primary); padding: 0; margin: 0 6px 0 0; }
.reconnect-banner__time { font-size: var(--font-size-16); color: var(--color-readout); padding: 0; margin: 0; }
.reconnect--danger .reconnect-banner__time { color: var(--color-danger); }
.reconnect-banner__detail { font-size: var(--font-size-12); color: var(--color-text-secondary); padding: 0; margin: 0 0 4px 0; }

/* The top bar's away tag (135:1503): grey name (Theme's eliminated style), icon, timer in warning. */
.top-bar__away { font-size: var(--font-size-12); color: var(--color-warning); padding: 0; margin: 0; }

/* The Play screen's Rejoin card (rejoin, 135:1509; Rejoining… 135:1524; under 10 s 135:1546). */
.rejoin-card { flex-direction: row; align-items: center; padding-right: 12px; background-color: var(--color-surface-raised); border-width: 1px; border-color: var(--color-warning); overflow: hidden; }
.rejoin-card__stripe { width: 4px; height: 72px; margin-right: 12px; background-color: var(--color-warning); }
.rejoin-card__body { flex-grow: 1; flex-shrink: 1; min-width: 1px; padding: 10px 12px 10px 0; }
.rejoin-card__title { font-size: var(--font-size-16); color: var(--color-text-primary); padding: 0; margin: 0 0 4px 0; }
.rejoin-card__meta { flex-direction: row; align-items: center; margin-bottom: 4px; }
.rejoin-card__meta .swatch { margin-right: 6px; }
.rejoin-card__match { font-size: var(--font-size-12); color: var(--color-text-secondary); padding: 0; margin: 0 6px 0 0; }
.rejoin-card__time { font-size: var(--font-size-12); color: var(--color-readout); padding: 0; margin: 0; }
.rejoin-card .reconnect-bar { background-color: var(--color-surface-base); }
.rejoin-card.reconnect--danger { border-color: var(--color-danger); }
.rejoin-card.reconnect--danger .rejoin-card__stripe { background-color: var(--color-danger); }
.rejoin-card.reconnect--danger .rejoin-card__time { color: var(--color-danger); }
.rejoin-card .button { flex-shrink: 0; }
