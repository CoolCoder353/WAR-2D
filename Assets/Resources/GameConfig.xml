      <TargetDistanceScale>150</TargetDistanceScale> <!-- tiles of distance that halve a target's score -->
      <HqValue>1500</HqValue>                        <!-- an enemy HQ's worth as a target -->
      <FinishAdvantage>4</FinishAdvantage>           <!-- this far ahead of an enemy's remembered army, its HQ is worth this many times more -->
      <MinerIncomeValue>150</MinerIncomeValue>       <!-- added to a Miner's worth for the income it denies -->
      <AvoidFactor>0.25</AvoidFactor>                <!-- a target where an attack lost badly scores this much ... -->
      <AvoidSeconds>240</AvoidSeconds>               <!-- ... this long -->
      <HomeGuardShare>0.2</HomeGuardShare>           <!-- army value kept home after a threat at its base ... -->
      <HomeGuardSeconds>300</HomeGuardSeconds>       <!-- ... this long after it -->
      <RaidSize>4</RaidSize>                         <!-- most units in a raid (0: no raids) -->
      <RaidMinSpeed>6</RaidMinSpeed>                 <!-- slowest raider (Scouts 9, Suicide bombers 8) -->
      <RaidAdvantage>1.5</RaidAdvantage>             <!-- a raid's advantage over its target's known defence -->
      <RaidSeconds>120</RaidSeconds>
      <BadTrade>0.6</BadTrade>                       <!-- enemy value lost over its own below this: a bad attack (more caution, target avoided) -->
      <GoodTrade>1.5</GoodTrade>                     <!-- above this: a good one (less caution) -->
      <CautionUp>1.25</CautionUp>                    <!-- caution (the attack threshold's factor) after a bad trade × this ... -->
      <CautionDown>0.9</CautionDown>                 <!-- ... after a good one × this ... -->
      <MinCaution>0.8</MinCaution>                   <!-- ... kept within these -->
      <MaxCaution>2</MaxCaution>
      <TurretCounterBoost>2</TurretCounterBoost>     <!-- turrets beat an attack: its counters against turrets weigh this much more -->
      <ModelHalfLife>120</ModelHalfLife>             <!-- an enemy's remembered unit counts halve this often when not seen again -->
      <RushUnits>4</RushUnits>                       <!-- this many enemy combat units seen at once ... -->
      <RushSeconds>240</RushSeconds>                 <!-- ... before this much play: a rusher -->
      <FastExpandSeconds>360</FastExpandSeconds>     <!-- an enemy expansion before this: an expander -->
      <PunishFactor>0.75</PunishFactor>              <!-- its first attack comes this much sooner against a greedy enemy -->
      <ReactionBias>1.5</ReactionBias>               <!-- what scouting found shifts its mix this much (a rush: Flamethrowers, Tanks; a Turtle: Artillery, Diggers) -->
      <TurtleRaidFactor>0.5</TurtleRaidFactor>       <!-- against a Turtle it raids this much more often -->
      <RushOverSeconds>30</RushOverSeconds>          <!-- a rush is seen off this long after the last threat at its base -->
      <StyleSwitchSeconds>180</StyleSwitchSeconds>   <!-- at most one style switch this often -->
      <TurtleBreakoutSeconds>900</TurtleBreakoutSeconds> <!-- a Turtle with the advantage this late becomes Balanced -->
      <SlipSeconds>10</SlipSeconds>                  <!-- a slip of one kind is rolled at most once this often -->
      <EconomyShare>0.4</EconomyShare>               <!-- share of its actions per minute kept for the economy -->
      <Variation>0.2</Variation>                     <!-- per match, its style's numbers vary by up to this share -->
      <GatherAngle>30</GatherAngle>                  <!-- degrees its gathering point may turn off the line to the enemy -->
    </Policy>
    <Counters>  <!-- spec 5.5: units weighted against each enemy unit seen (Normal, Hard) and what each enemy building makes (Hard) -->
      <Counter seen="Heavy">Sniper:2 Artillery:2 Heavy:1</Counter>
      <Counter seen="Artillery">Scout:1 Tank:2 SuicideBomber:1</Counter>
      <Counter seen="Sniper">Scout:2 Tank:2</Counter>
      <Counter seen="Tank">Flamethrower:3 Heavy:1</Counter>
      <Counter seen="Scout">Flamethrower:2 Tank:1</Counter>
      <Counter seen="Flamethrower">Artillery:1 Sniper:2 Heavy:1</Counter>
      <Counter seen="SuicideBomber">Tank:2 Sniper:1</Counter>
      <Counter seen="Digger">Tank:2</Counter>
      <Counter building="Barracks">Flamethrower:2 Tank:1</Counter>
      <Counter building="HeavyFactory">Sniper:2 Artillery:2</Counter>
      <Counter building="SiegeWorkshop">Tank:2 Sniper:1</Counter>
      <Counter building="GunTurret">Artillery:3 Heavy:1</Counter>
    </Counters>
  </Ai>

