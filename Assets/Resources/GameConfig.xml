<?xml version="1.0" encoding="utf-8"?>
<!-- All gameplay balance values. Parsed by Config.ConfigParser (invariant culture, strict). -->
<GameConfig>
  <Resources>
    <PassiveGenerationRate>5.0</PassiveGenerationRate>
    <StartingResources>1000.0</StartingResources>
    <MiningRate>10.0</MiningRate>
    <!-- Percent of max health lost per second while an entity's upkeep is unpaid. -->
    <DecayPercentPerSecond>5.0</DecayPercentPerSecond>
  </Resources>

  <Match>
    <Scene>Map_2</Scene>
    <CountdownSeconds>5.0</CountdownSeconds>
    <Map>
      <Size>1024</Size>          <!-- tiles per side; 0 = use the scene's tilemaps (Map_2). v0.3 results: map size -->
      <Seed>0</Seed>             <!-- 0 = a new random seed every match -->
      <GemChance>0.04</GemChance> <!-- share of floor-facing rock that becomes gem; tune in play -->
    </Map>
  </Match>

  <Simulation>
    <TickRate>20</TickRate>                               <!-- spec 4.2 -->
    <TargetSearchSliceTicks>8</TargetSearchSliceTicks>   <!-- v0.3 sim fallback 1 -->
    <SeparationIntervalTicks>2</SeparationIntervalTicks> <!-- v0.3 sim fallback 2 -->
    <SeparationStrength>1.0</SeparationStrength>         <!-- spike default -->
    <HashCellSize>5</HashCellSize>                       <!-- v0.3 hash row -->
    <MaxFieldRebuildsPerTick>2</MaxFieldRebuildsPerTick> <!-- v0.3 flow row -->
    <MaxUnitsPerPlayer>10000</MaxUnitsPerPlayer>         <!-- spec 1 -->
    <MaxEntities>131072</MaxEntities>                    <!-- 8 x 10k plus churn and buildings -->
    <FogCellSize>2</FogCellSize>                         <!-- v0.5: fog grid cell size in tiles -->
    <VisionIntervalTicks>4</VisionIntervalTicks>         <!-- v0.5: fog recomputed at 5 Hz -->
  </Simulation>

  <Replication>
    <CorrectionIntervalTicks>4</CorrectionIntervalTicks>     <!-- v0.3 bandwidth ladder step 1 -->
    <CorrectionThreshold>0.25</CorrectionThreshold>          <!-- v0.3 bandwidth chosen configuration (tiles) -->
    <DeltaScale>8</DeltaScale>                               <!-- v0.3 ladder step 2 -->
    <OffscreenThreshold>2.0</OffscreenThreshold>             <!-- v0.3 view tier (tiles) -->
    <OffscreenIntervalTicks>20</OffscreenIntervalTicks>      <!-- v0.3 view tier -->
    <SnapshotBytesPerSecond>262144</SnapshotBytesPerSecond>  <!-- v0.3 snapshot row -->
  </Replication>

  <Orders>
    <MaxQueued>4</MaxQueued>  <!-- v0.6: Shift-queued waypoints per unit -->
  </Orders>

  <Diplomacy>
    <ChangeCooldownSeconds>2.0</ChangeCooldownSeconds>  <!-- v0.6: per player, per command -->
  </Diplomacy>

  <Lobby>
    <MapSizes>256 512 1024</MapSizes>                    <!-- v0.6: map sizes the host may pick -->
    <StartingResources>500 1000 2500 5000</StartingResources> <!-- v0.6: starting resources the host may pick -->
  </Lobby>

  <MenuBattle>
    <UnitsPerArmy>1500</UnitsPerArmy>  <!-- v0.6: each of the two armies behind the main menu -->
    <MapSize>512</MapSize>             <!-- v0.6: its generated map -->
    <Seed>7</Seed>
  </MenuBattle>

  <Gifting>
    <CooldownSeconds>5.0</CooldownSeconds>  <!-- v0.6: per sender -->
  </Gifting>

  <Alerts>
    <ThrottleSeconds>10.0</ThrottleSeconds>  <!-- v0.6: one Under-attack alert per area per window -->
    <AreaTiles>32</AreaTiles>                <!-- v0.6: side of an alert area, in tiles -->
    <ShowSeconds>8.0</ShowSeconds>           <!-- v0.6: how long an alert stays in the feed -->
  </Alerts>

  <!-- Damage multiplier per attacker unit type and target class (Unit, Building, Wall); 1.0 when missing. -->
  <DamageTable>
    <Entry attacker="Tank" target="Unit">1.0</Entry>
    <Entry attacker="Tank" target="Building">1.0</Entry>
    <Entry attacker="Tank" target="Wall">0.5</Entry>
  </DamageTable>

  <Units>
    <Unit type="Tank">
      <Health>100</Health>
      <Damage>10</Damage>
      <Range>5.0</Range>
      <AttackInterval>1.0</AttackInterval>
      <MoveSpeed>5.0</MoveSpeed>
      <Acceleration>5.0</Acceleration>
      <UpfrontCost>50.0</UpfrontCost>
      <RunningCost>2.0</RunningCost>
      <Radius>0.35</Radius>       <!-- collision radius in tiles (v0.3 D2) -->
      <SizeClass>0</SizeClass>    <!-- pathing size class: 0 small, 1 large -->
      <Sight>8.0</Sight>          <!-- v0.5: sight radius in tiles -->
    </Unit>
  </Units>

  <Buildings>
    <Building type="Base">
      <Health>500</Health>
      <Width>3</Width>
      <Height>3</Height>
      <UpfrontCost>0.0</UpfrontCost>
      <RunningCost>0.0</RunningCost>
      <SpawnRate>0.0</SpawnRate>
      <Sight>10.0</Sight>
    </Building>
    <Building type="Miner">
      <Health>50</Health>
      <Width>1</Width>
      <Height>1</Height>
      <UpfrontCost>50.0</UpfrontCost>
      <RunningCost>0.0</RunningCost>
      <SpawnRate>0.0</SpawnRate>
      <Sight>4.0</Sight>
    </Building>
    <Building type="SmallUnitSpawner">
      <Health>300</Health>
      <Width>2</Width>
      <Height>2</Height>
      <UpfrontCost>200.0</UpfrontCost>
      <RunningCost>20.0</RunningCost>
      <SpawnRate>1.0</SpawnRate>
      <Sight>6.0</Sight>
    </Building>
  </Buildings>
</GameConfig>
